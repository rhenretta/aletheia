{
  "name": "aletheia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rm -rf .next && next dev",
    "clean": "rm -rf .next",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "doc-sync": "tsx src/scripts/sync-docs.ts",
    "db:migrate": "tsx src/scripts/migrate-db.ts",
    "prod:inspect": "tsx src/scripts/prod-inspector.ts",
    "validate": "npm run typecheck && npm run test && npm run clean && npm run build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1125.0",
    "@aws-sdk/client-sns": "^3.1125.0",
    "@google/generative-ai": "^0.24.0",
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.45",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^14.2.23",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
